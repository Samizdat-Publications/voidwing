{
  "name": "voidwing",
  "private": true,
  "version": "1.0.0",
  "description": "VOID WING - a 3D space combat game built with Vite, TypeScript and Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "playtest": "node scripts/playtest.mjs",
    "assets": "node scripts/build-assets.mjs",
    "site": "node scripts/build-site.mjs",
    "media": "node scripts/make-media.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
